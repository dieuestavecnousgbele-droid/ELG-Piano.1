@Composable
private fun MidiDialog(midi: MidiController, onDismiss: () -> Unit) {
    val midiState by midi.state.collectAsStateWithLifecycle()
    val context = LocalContext.current

    val permissionLauncher = rememberLauncherForActivityResult(
        ActivityResultContracts.RequestMultiplePermissions()
    ) { result ->
        if (result.values.all { it }) {
            midi.startBleScan()
        } else {
            midi.setMessage("Permission Bluetooth refusée.")
        }
    }

    fun close() {
        midi.stopBleScan()
        onDismiss()
    }

    AlertDialog(
        onDismissRequest = { close() },
        confirmButton = { TextButton(onClick = { close() }) { Text("Fermer") } },
        title = { Text("Clavier MIDI") },
        text = {
            Column(
                modifier = Modifier.verticalScroll(rememberScrollState()),
                verticalArrangement = Arrangement.spacedBy(6.dp)
            ) {
                if (midiState.connected.isEmpty()) {
                    Text("Aucun clavier connecté. Branchez un clavier USB (adaptateur OTG) : il est détecté automatiquement.")
                } else {
                    for (name in midiState.connected) Text("✔ $name")
                }
                HorizontalDivider()
                Text("Bluetooth")
                OutlinedButton(
                    enabled = !midiState.scanning,
                    onClick = {
                        val needed = MidiController.blePermissions()
                        val granted = needed.all {
                            ContextCompat.checkSelfPermission(context, it) == PackageManager.PERMISSION_GRANTED
                        }
                        if (granted) midi.startBleScan() else permissionLauncher.launch(needed)
                    }
                ) {
                    Text(if (midiState.scanning) "Recherche en cours…" else "Rechercher un clavier Bluetooth")
                }
                for (device in midiState.found) {
                    TextButton(onClick = { midi.connectBle(device) }) { Text(device.name) }
