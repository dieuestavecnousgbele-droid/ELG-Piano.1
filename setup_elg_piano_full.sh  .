package com.elg.piano

import android.app.Application
import android.content.Context
import androidx.lifecycle.AndroidViewModel
import androidx.lifecycle.viewModelScope
import com.elg.piano.midi.MidiController
import com.elg.piano.midi.MidiEventListener
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.flow.update
import kotlinx.coroutines.flow.updateAndGet
import kotlinx.coroutines.launch

data class PianoUiState(
    val instrument: Instrument = Instrument.GRAND_PIANO,
    val loaded: Set<Instrument> = emptySet(),
    val loadingInstrument: Instrument? = null,
    val pressed: Set<Int> = emptySet(),
    val visibleKeys: Int = 14,
    val reverb: Float = 0.3f,
    val volume: Float = 0.8f,
    val noteNames: Boolean = false,
    val pedalHeld: Boolean = false,
    val sustainLatch: Boolean = false,
    val midiSustain: Boolean = false,
    val error: String? = null
) {
    /** La pédale forte est active si l'une des trois sources l'est. */
    val sustain: Boolean get() = pedalHeld || sustainLatch || midiSustain
}

class PianoViewModel(application: Application) : AndroidViewModel(application) {

    private val prefs = application.getSharedPreferences("elg_piano_prefs", Context.MODE_PRIVATE)

    private val _state = MutableStateFlow(
        PianoUiState(
            instrument = Instrument.entries.getOrElse(prefs.getInt("instrument", 0)) { Instrument.GRAND_PIANO },
            visibleKeys = prefs.getInt("visible_keys", 14).coerceIn(7, 21),
            reverb = prefs.getFloat("reverb", 0.3f).coerceIn(0f, 1f),
            volume = prefs.getFloat("volume", 0.8f).coerceIn(0f, 1f),
            noteNames = prefs.getBoolean("note_names", false)
        )
    )
    val state: StateFlow<PianoUiState> = _state.asStateFlow()

    // Nombre de doigts / sources posés par note (touches tactiles et clavier MIDI).
    private val pressLock = Any()
    private val pressCount = IntArray(128)

    private val midiListener = object : MidiEventListener {
        override fun onNoteOn(note: Int, velocity: Float) {
            noteOn(note, velocity)
        }

        override fun onNoteOff(note: Int) {
            noteOff(note)
        }

        override fun onSustain(on: Boolean) {
            setMidiSustain(on)
        }

        override fun onAllNotesOff() {
            releaseAll()
        }
    }

    val midi = MidiController(application, midiListener)

    init {
        midi.start()
        viewModelScope.launch(Dispatchers.IO) { boot() }
    }

    // -------------------------------------------------------------------------
    // Démarrage : seul l'instrument actif est copié et chargé (démarrage rapide,
    // mémoire économisée). L'autre est chargé à la première sélection.
    // -------------------------------------------------------------------------

    private fun boot() {
        try {
            val sampleRate = NativeEngine.nativeStart()
            if (sampleRate <= 0) throw IllegalStateException("Moteur audio indisponible")

            val s = _state.value
            NativeEngine.nativeSetReverb(s.reverb)
            NativeEngine.nativeSetVolume(s.volume)

            loadInstrument(s.instrument)
            NativeEngine.nativeSetInstrument(s.instrument.ordinal)
        } catch (e: Exception) {
            _state.update { it.copy(error = e.message ?: "Erreur inconnue") }
        }
    }

    private fun loadInstrument(instrument: Instrument) {
        val file = SoundFontInstaller.ensureInstalled(getApplication(), instrument)
        if (!NativeEngine.nativeLoad(instrument.ordinal, file.absolutePath)) {
            throw IllegalStateException("Échec du chargement : ${instrument.label}")
        }
        _state.update { it.copy(loaded = it.loaded + instrument) }
    }

    // -------------------------------------------------------------------------
    // Jeu (tactile et MIDI)
    // -------------------------------------------------------------------------

    fun noteOn(note: Int, velocity: Float) {
        if (note !in 0..127) return
        synchronized(pressLock) { pressCount[note]++ }
        NativeEngine.nativeNoteOn(note, velocity)
        _state.update { it.copy(pressed = it.pressed + note) }
    }

    fun noteOff(note: Int) {
        if (note !in 0..127) return
        val release = synchronized(pressLock) {
            if (pressCount[note] == 0) {
                false
            } else {
                pressCount[note]--
                pressCount[note] == 0
            }
        }
        if (release) {
            NativeEngine.nativeNoteOff(note)
            _state.update { it.copy(pressed = it.pressed - note) }
        }
    }

    private fun releaseAll() {
        synchronized(pressLock) { pressCount.fill(0) }
        NativeEngine.nativeAllNotesOff()
        _state.update { it.copy(pressed = emptySet()) }
    }

    // -------------------------------------------------------------------------
    // Pédale forte
    // -------------------------------------------------------------------------

    fun setPedalHeld(held: Boolean) {
        val s = _state.updateAndGet { it.copy(pedalHeld = held) }
        NativeEngine.nativeSetSustain(s.sustain)
    }

    fun setSustainLatch(latch: Boolean) {
        val s = _state.updateAndGet { it.copy(sustainLatch = latch) }
        NativeEngine.nativeSetSustain(s.sustain)
    }

    private fun setMidiSustain(on: Boolean) {
        val s = _state.updateAndGet { it.copy(midiSustain = on) }
        NativeEngine.nativeSetSustain(s.sustain)
    }

    // -------------------------------------------------------------------------
    // Instruments
    // -------------------------------------------------------------------------

    fun selectInstrument(instrument: Instrument) {
        val s = _state.value
        if (instrument == s.instrument || s.loadingInstrument != null) return
        if (instrument in s.loaded) {
            switchTo(instrument)
            return
        }
        viewModelScope.launch(Dispatchers.IO) {
            _state.update { it.copy(loadingInstrument = instrument) }
            try {
                loadInstrument(instrument)
                switchTo(instrument)
            } catch (e: Exception) {
                _state.update { it.copy(error = e.message ?: "Erreur inconnue") }
            } finally {
                _state.update { it.copy(loadingInstrument = null) }
            }
        }
    }

    private fun switchTo(instrument: Instrument) {
        releaseAll()
        NativeEngine.nativeSetInstrument(instrument.ordinal)
        _state.update { it.copy(instrument = instrument) }
        prefs.edit().putInt("instrument", instrument.ordinal).apply()
    }

    // -------------------------------------------------------------------------
    // Réglages (persistants)
    // -------------------------------------------------------------------------

    fun setVisibleKeys(count: Int) {
        val value = count.coerceIn(7, 21)
        _state.update { it.copy(visibleKeys = value) }
        prefs.edit().putInt("visible_keys", value).apply()
    }

    fun setReverb(level: Float) {
        val value = level.coerceIn(0f, 1f)
        NativeEngine.nativeSetReverb(value)
        _state.update { it.copy(reverb = value) }
        prefs.edit().putFloat("reverb", value).apply()
    }

    fun setVolume(volume: Float) {
        val value = volume.coerceIn(0f, 1f)
        NativeEngine.nativeSetVolume(value)
        _state.update { it.copy(volume = value) }
        prefs.edit().putFloat("volume", value).apply()
    }

    fun setNoteNames(show: Boolean) {
        _state.update { it.copy(noteNames = show) }
        prefs.edit().putBoolean("note_names", show).apply()
    }

    // -------------------------------------------------------------------------
    // Cycle de vie
    // -------------------------------------------------------------------------

    fun onAppBackground() {
        releaseAll()
        val s = _state.updateAndGet { it.copy(pedalHeld = false) }
        NativeEngine.nativeSetSustain(s.sustain)
        NativeEngine.nativePause()
    }

    fun onAppForeground() {
        NativeEngine.nativeResume()
    }

    override fun onCleared() {
        midi.stop()
        NativeEngine.nativeStop()
        super.onCleared()
    }
}
