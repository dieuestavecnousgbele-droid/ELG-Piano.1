package com.elg.piano.midi

import android.media.midi.MidiReceiver

/** Événements MIDI utiles à l'application. */
interface MidiEventListener {
    fun onNoteOn(note: Int, velocity: Float)
    fun onNoteOff(note: Int)
    fun onSustain(on: Boolean)
    fun onAllNotesOff()
}

/**
 * Analyseur de flux MIDI (gère le running status, ignore les messages système).
 * Tous les canaux sont acceptés.
 */
class MidiParser(private val listener: MidiEventListener) : MidiReceiver() {
    private var status = 0
    private var data1 = -1
    private var inSysex = false

    override fun onSend(msg: ByteArray, offset: Int, count: Int, timestamp: Long) {
        for (i in offset until offset + count) {
            val b = msg[i].toInt() and 0xFF
            if (b >= 0xF8) continue  // messages temps réel : ignorés
            if (b >= 0x80) {
                when {
                    b == 0xF0 -> {
                        inSysex = true
                        status = 0
                        data1 = -1
                    }
                    b == 0xF7 -> inSysex = false
                    b >= 0xF0 -> {
                        status = 0
                        data1 = -1
                    }
                    else -> {
                        inSysex = false
                        status = b
                        data1 = -1
                    }
                }
                continue
            }
            if (inSysex || status == 0) continue
            val type = status and 0xF0
            if (type == 0xC0 || type == 0xD0) continue  // un seul octet de données : ignoré
            if (data1 < 0) {
                data1 = b
            } else {
                dispatch(type, data1, b)
                data1 = -1
            }
        }
    }

    private fun dispatch(type: Int, d1: Int, d2: Int) {
        when (type) {
            0x90 -> if (d2 > 0) listener.onNoteOn(d1, d2 / 127f) else listener.onNoteOff(d1)
            0x80 -> listener.onNoteOff(d1)
            0xB0 -> when (d1) {
                64 -> listener.onSustain(d2 >= 64)
                120, 123 -> listener.onAllNotesOff()
            }
        }
    }
}
EOF_MIDIEVENTS

