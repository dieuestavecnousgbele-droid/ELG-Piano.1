package com.elg.piano.midi

import android.Manifest
import android.annotation.SuppressLint
import android.bluetooth.BluetoothDevice
import android.bluetooth.BluetoothManager
import android.bluetooth.le.ScanCallback
import android.bluetooth.le.ScanFilter
import android.bluetooth.le.ScanResult
import android.bluetooth.le.ScanSettings
import android.content.Context
import android.content.pm.PackageManager
import android.media.midi.MidiDevice
import android.media.midi.MidiDeviceInfo
import android.media.midi.MidiManager
import android.media.midi.MidiOutputPort
import android.os.Build
import android.os.Handler
import android.os.Looper
import android.os.ParcelUuid
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.flow.update
import java.io.IOException
import java.util.UUID

data class BleDevice(val name: String, val address: String, val device: BluetoothDevice)

data class MidiUiState(
    val connected: List<String> = emptyList(),
    val scanning: Boolean = false,
    val found: List<BleDevice> = emptyList(),
    val message: String? = null
)

/**
 * Détecte les claviers MIDI USB (OTG) et Bluetooth LE, et transmet leurs
 * événements (Note On/Off, vélocité, pédale de sustain) à l'application.
 * Toutes les opérations MIDI s'exécutent sur le thread principal.
 */
class MidiController(
    private val context: Context,
    private val listener: MidiEventListener
) {
    private class Connection(val device: MidiDevice, val port: MidiOutputPort, val name: String)

    private val midiManager: MidiManager? =
        if (context.packageManager.hasSystemFeature(PackageManager.FEATURE_MIDI)) {
            context.getSystemService(Context.MIDI_SERVICE) as? MidiManager
        } else {
            null
        }

    private val handler = Handler(Looper.getMainLooper())
    private val connections = HashMap<Int, Connection>()

    private val _state = MutableStateFlow(MidiUiState())
    val state: StateFlow<MidiUiState> = _state.asStateFlow()

    private var scanCallback: ScanCallback? = null
    private val stopScanRunnable = Runnable { stopBleScan() }

    private val deviceCallback = object : MidiManager.DeviceCallback() {
        override fun onDeviceAdded(device: MidiDeviceInfo) {
            openDevice(device)
        }

        override fun onDeviceRemoved(device: MidiDeviceInfo) {
            detach(device.id)
        }
    }

    fun start() {
        val manager = midiManager
        if (manager == null) {
            setMessage("MIDI non pris en charge sur cet appareil.")
            return
        }
        manager.registerDeviceCallback(deviceCallback, handler)
        for (info in existingDevices()) openDevice(info)
    }

    @Suppress("DEPRECATION")
    private fun existingDevices(): List<MidiDeviceInfo> =
        midiManager?.devices?.toList() ?: emptyList()

    fun stop() {
        stopBleScan()
        midiManager?.unregisterDeviceCallback(deviceCallback)
        for (id in connections.keys.toList()) detach(id)
    }

    fun setMessage(text: String?) {
        _state.update { it.copy(message = text) }
    }

    private fun openDevice(info: MidiDeviceInfo) {
        val manager = midiManager ?: return
        if (info.outputPortCount == 0 || connections.containsKey(info.id)) return
        manager.openDevice(
            info,
            MidiManager.OnDeviceOpenedListener { device -> if (device != null) attach(device) },
            handler
        )
    }

    private fun attach(device: MidiDevice) {
        val info = device.info
        if (info.outputPortCount == 0 || connections.containsKey(info.id)) {
            closeQuietly(device, null)
            return
        }
        val port = device.openOutputPort(0)
        if (port == null) {
            closeQuietly(device, null)
            return
        }
        port.connect(MidiParser(listener))
        val name = info.properties.getString(MidiDeviceInfo.PROPERTY_NAME) ?: "Clavier MIDI"
        connections[info.id] = Connection(device, port, name)
        publishConnected()
    }

    private fun detach(id: Int) {
        val connection = connections.remove(id) ?: return
        closeQuietly(connection.device, connection.port)
        publishConnected()
        listener.onAllNotesOff()
    }

    private fun closeQuietly(device: MidiDevice, port: MidiOutputPort?) {
        try {
            port?.close()
        } catch (e: IOException) {
            // ignoré
        }
        try {
            device.close()
        } catch (e: IOException) {
            // ignoré
        }
    }

    private fun publishConnected() {
        val names = connections.values.map { it.name }
        _state.update { it.copy(connected = names) }
    }

    // -------------------------------------------------------------------------
    // Bluetooth LE MIDI
    // -------------------------------------------------------------------------

    @SuppressLint("MissingPermission")
    fun startBleScan() {
        if (midiManager == null) {
            setMessage("MIDI non pris en charge sur cet appareil.")
            return
        }
        if (_state.value.scanning) return
        val adapter = (context.getSystemService(Context.BLUETOOTH_SERVICE) as? BluetoothManager)?.adapter
        if (adapter == null || !adapter.isEnabled) {
            setMessage("Activez le Bluetooth pour rechercher un clavier.")
            return
        }
        val scanner = adapter.bluetoothLeScanner
        if (scanner == null) {
            setMessage("Recherche Bluetooth indisponible.")
            return
        }

        val callback = object : ScanCallback() {
            override fun onScanResult(callbackType: Int, result: ScanResult) {
                val device = result.device
                val name = safeName(device)
                _state.update { s ->
                    if (s.found.any { it.address == device.address }) {
                        s
                    } else {
                        s.copy(found = s.found + BleDevice(name, device.address, device))
                    }
                }
            }

            override fun onScanFailed(errorCode: Int) {
                scanCallback = null
                handler.removeCallbacks(stopScanRunnable)
                _state.update { it.copy(scanning = false, message = "Échec de la recherche Bluetooth ($errorCode).") }
            }
        }

        val filter = ScanFilter.Builder().setServiceUuid(ParcelUuid(BLE_MIDI_SERVICE)).build()
        val settings = ScanSettings.Builder().setScanMode(ScanSettings.SCAN_MODE_LOW_LATENCY).build()
        try {
            scanner.startScan(listOf(filter), settings, callback)
        } catch (e: SecurityException) {
            setMessage("Permission Bluetooth refusée.")
            return
        } catch (e: IllegalStateException) {
            setMessage("Recherche Bluetooth impossible.")
            return
        }
        scanCallback = callback
        _state.update { it.copy(scanning = true, found = emptyList(), message = null) }
        handler.postDelayed(stopScanRunnable, SCAN_DURATION_MS)
    }

    @SuppressLint("MissingPermission")
    fun stopBleScan() {
        handler.removeCallbacks(stopScanRunnable)
        val callback = scanCallback
        scanCallback = null
        if (callback != null) {
            try {
                val adapter = (context.getSystemService(Context.BLUETOOTH_SERVICE) as? BluetoothManager)?.adapter
                adapter?.bluetoothLeScanner?.stopScan(callback)
            } catch (e: SecurityException) {
                // ignoré
            } catch (e: IllegalStateException) {
                // ignoré
            }
        }
        _state.update { it.copy(scanning = false) }
    }

    @SuppressLint("MissingPermission")
    fun connectBle(target: BleDevice) {
        val manager = midiManager ?: return
        stopBleScan()
        setMessage("Connexion à ${target.name}…")
        try {
            manager.openBluetoothDevice(
                target.device,
                MidiManager.OnDeviceOpenedListener { device ->
                    if (device != null) {
                        attach(device)
                        setMessage(null)
                    } else {
                        setMessage("Connexion Bluetooth impossible.")
                    }
                },
                handler
            )
        } catch (e: SecurityException) {
            setMessage("Permission Bluetooth refusée.")
        }
    }

    @SuppressLint("MissingPermission")
    private fun safeName(device: BluetoothDevice): String {
        val name = try {
            device.name
        } catch (e: SecurityException) {
            null
        }
        return name ?: device.address
    }

    companion object {
        private val BLE_MIDI_SERVICE: UUID = UUID.fromString("03B80E5A-EDE8-4B33-A751-6CE34EC4C700")
        private const val SCAN_DURATION_MS = 12_000L

        /** Permissions nécessaires à la recherche d'un clavier Bluetooth. */
        fun blePermissions(): Array<String> =
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
                arrayOf(Manifest.permission.BLUETOOTH_SCAN, Manifest.permission.BLUETOOTH_CONNECT)
            } else {
                arrayOf(Manifest.permission.ACCESS_FINE_LOCATION)
            }
    }
}
