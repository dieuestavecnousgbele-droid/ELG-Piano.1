@Composable
fun PianoScreen(viewModel: PianoViewModel = viewModel()) {
    val state by viewModel.state.collectAsStateWithLifecycle()
    val midiState by viewModel.midi.state.collectAsStateWithLifecycle()
    val scope = rememberCoroutineScope()
    var showSettings by remember { mutableStateOf(false) }
    var showMidi by remember { mutableStateOf(false) }

    // Position (fractionnaire) de la touche blanche affichée à gauche ; 16 = Do3.
    val maxLeft = (WHITE_KEY_COUNT - state.visibleKeys).toFloat()
    val leftKey = remember { Animatable(16f) }
    LaunchedEffect(maxLeft) {
        if (leftKey.value > maxLeft) leftKey.snapTo(maxLeft)
    }

    LifecycleEventEffect(Lifecycle.Event.ON_STOP) { viewModel.onAppBackground() }
    LifecycleEventEffect(Lifecycle.Event.ON_START) { viewModel.onAppForeground() }

    fun shiftOctave(direction: Int) {
        scope.launch {
            leftKey.animateTo((leftKey.value + direction * 7f).coerceIn(0f, maxLeft))
        }
    }

    val error = state.error
    val busyInstrument = state.loadingInstrument ?: if (state.instrument !in state.loaded) state.instrument else null

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(Color(0xFF121214))
            .safeDrawingPadding()
            .padding(horizontal = 12.dp, vertical = 6.dp)
    ) {
        // --- Barre du haut -----------------------------------------------------
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .horizontalScroll(rememberScrollState()),
            verticalAlignment = Alignment.CenterVertically,
            horizontalArrangement = Arrangement.spacedBy(8.dp)
        ) {
            Text(
                text = "ELG Piano",
                color = Color.White,
                style = MaterialTheme.typography.titleMedium
            )
            for (instrument in Instrument.entries) {
                FilterChip(
                    selected = state.instrument == instrument,
                    enabled = state.loadingInstrument == null,
                    onClick = { viewModel.selectInstrument(instrument) },
                    label = { Text(instrument.label) }
                )
            }
            PedalButton(active = state.sustain, onHold = viewModel::setPedalHeld)
            FilterChip(
                selected = state.sustainLatch,
                onClick = { viewModel.setSustainLatch(!state.sustainLatch) },
                label = { Text("Maintien") }
            )
            OutlinedButton(onClick = { showMidi = true }) {
                Text(if (midiState.connected.isEmpty()) "MIDI" else "MIDI (${midiState.connected.size})")
            }
            OutlinedButton(onClick = { showSettings = !showSettings }) {
                Text(if (showSettings) "Réglages ▲" else "Réglages ▼")
            }
        }

        if (error != null) {
            Text(
                text = error,
                color = Color(0xFFFF8A80),
                modifier = Modifier.padding(vertical = 4.dp)
            )
        } else if (busyInstrument != null) {
            Row(
                modifier = Modifier.padding(vertical = 4.dp),
                verticalAlignment = Alignment.CenterVertically,
                horizontalArrangement = Arrangement.spacedBy(8.dp)
            ) {
                CircularProgressIndicator(modifier = Modifier.size(16.dp), strokeWidth = 2.dp)
                Text(text = "Chargement : ${busyInstrument.label}…", color = Color.LightGray)
            }
        }

        // --- Réglages ----------------------------------------------------------
        if (showSettings) {
            Row(
                modifier = Modifier.fillMaxWidth(),
                verticalAlignment = Alignment.CenterVertically,
                horizontalArrangement = Arrangement.spacedBy(16.dp)
            ) {
                LabeledSlider(
                    label = "Touches visibles",
                    valueText = "${state.visibleKeys}",
                    value = state.visibleKeys.toFloat(),
                    range = 7f..21f,
                    steps = 13,
                    onChange = { viewModel.setVisibleKeys(it.roundToInt()) },
                    modifier = Modifier.weight(1f)
                )
                LabeledSlider(
                    label = "Réverbération",
                    valueText = "${(state.reverb * 100).roundToInt()} %",
                    value = state.reverb,
                    range = 0f..1f,
                    steps = 0,
                    onChange = { viewModel.setReverb(it) },
                    modifier = Modifier.weight(1f)
                )
                LabeledSlider(
                    label = "Volume",
                    valueText = "${(state.volume * 100).roundToInt()} %",
                    value = state.volume,
                    range = 0f..1f,
                    steps = 0,
                    onChange = { viewModel.setVolume(it) },
                    modifier = Modifier.weight(1f)
                )
                FilterChip(
                    selected = state.noteNames,
                    onClick = { viewModel.setNoteNames(!state.noteNames) },
                    label = { Text("Do Ré Mi") }
                )
            }
        }

        // --- Navigation entre les octaves ----------------------------------------
        Row(
            modifier = Modifier.fillMaxWidth(),
            verticalAlignment = Alignment.CenterVertically,
            horizontalArrangement = Arrangement.spacedBy(8.dp)
        ) {
            OutlinedButton(onClick = { shiftOctave(-1) }) { Text("◀ Octave") }
            Slider(
                value = leftKey.value.coerceIn(0f, maxLeft),
                onValueChange = { value -> scope.launch { leftKey.snapTo(value) } },
                valueRange = 0f..maxLeft,
                modifier = Modifier.weight(1f)
            )
            OutlinedButton(onClick = { shiftOctave(1) }) { Text("Octave ▶") }
        }

        // --- Clavier -------------------------------------------------------------
        PianoKeyboard(
            pressed = state.pressed,
            visibleWhiteKeys = state.visibleKeys,
            leftKey = leftKey.value,
            showNoteNames = state.noteNames,
            onNoteOn = viewModel::noteOn,
            onNoteOff = viewModel::noteOff,
            modifier = Modifier
                .fillMaxWidth()
                .weight(1f)
                .padding(top = 4.dp)
        )
    }

    if (showMidi) {
        MidiDialog(
            midi = viewModel.midi,
            onDismiss = { showMidi = false }
        )
    }
}

/** Pédale forte : maintenue tant que le doigt reste posé sur le bouton. */
@Composable
private fun PedalButton(active: Boolean, onHold: (Boolean) -> Unit) {
    Box(
        modifier = Modifier
            .height(40.dp)
            .widthIn(min = 96.dp)
            .background(
                color = if (active) Color(0xFF3E78C9) else Color(0xFF2A2A2E),
                shape = RoundedCornerShape(20.dp)
            )
            .pointerInput(Unit) {
                detectTapGestures(
                    onPress = {
                        onHold(true)
                        try {
                            tryAwaitRelease()
                        } finally {
                            onHold(false)
                        }
                    }
                )
            },
        contentAlignment = Alignment.Center
    ) {
        Text(text = "Pédale", color = Color.White)
    }
}

@Composable
private fun LabeledSlider(
    label: String,
    valueText: String,
    value: Float,
    range: ClosedFloatingPointRange<Float>,
    steps: Int,
    onChange: (Float) -> Unit,
    modifier: Modifier = Modifier
) {
